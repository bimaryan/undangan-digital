# ============================================================
# ENVIRONMENT VARIABLES - INOVAINVITE.COM
# Salin file ini menjadi .env.local (lokal) atau .env (server)
# ============================================================

# --- DATABASE ---
# Pilih SALAH SATU opsi di bawah:

# Opsi A: Connection string (untuk Supabase, Neon, Railway, dsb.)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Opsi B: Variabel terpisah (untuk VPS PostgreSQL lokal)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_strong_password_here
PGDATABASE=undangan_db

# SSL untuk database cloud (atur true jika pakai managed DB)
# DB_SSL=true

# --- NEXT.JS APP ---
# URL utama aplikasi (tanpa trailing slash)
NEXT_PUBLIC_SITE_URL=https://inovainvite.com

# Slug undangan yang dikunci di halaman /admin (satu undangan per deploy)
NEXT_PUBLIC_FIXED_SLUG=khitanan-zayyan-arkana-alfarizqi

# Token akses halaman /admin untuk slug di atas. Nilai ini dibaca browser,
# jadi gunakan token khusus undangan dan jangan gunakan kata sandi utama.
NEXT_PUBLIC_FIXED_TOKEN=bumarpuah

# Opsional: token master server untuk integrasi API (tidak dikirim ke browser).
# ADMIN_TOKEN=ganti_dengan_token_rahasia_yang_panjang

# --- OPSIONAL ---
# NODE_ENV diatur otomatis oleh Next.js (production / development)
# NODE_ENV=production
